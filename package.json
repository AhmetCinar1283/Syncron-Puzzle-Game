{
  "name": "syncron",
  "version": "0.3.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_PLATFORM=web next dev",
    "dev:mock": "cross-env NEXT_PUBLIC_PLATFORM=mock next dev",
    "build": "cross-env NEXT_PUBLIC_PLATFORM=web next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "build:mobile": "cross-env NEXT_PUBLIC_PLATFORM=android next build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "electron:dev": "cross-env NEXT_PUBLIC_PLATFORM=electron node electron/dev-runner.js",
    "electron:serve": "cross-env NEXT_PUBLIC_PLATFORM=electron next build && electron .",
    "electron:pack": "cross-env NEXT_PUBLIC_PLATFORM=electron next build && electron-builder --dir",
    "electron:dist": "cross-env NEXT_PUBLIC_PLATFORM=electron next build && electron-builder",
    "electron:dist:win": "cross-env NEXT_PUBLIC_PLATFORM=electron next build && electron-builder --win",
    "electron:dist:mac": "cross-env NEXT_PUBLIC_PLATFORM=electron next build && electron-builder --mac",
    "electron:dist:linux": "cross-env NEXT_PUBLIC_PLATFORM=electron next build && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/app": "^8.1.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@reduxjs/toolkit": "^2.11.2",
    "firebase": "^12.11.0",
    "lucide-react": "^1.17.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "framer-motion": "^12.38.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
