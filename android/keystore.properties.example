# Bu dosyayı "keystore.properties" olarak kopyalayıp kendi değerlerinizi girin.
# keystore.properties gitignore'ludur — asla commit etmeyin.
#
# storeFile: android/ klasörüne göre relatif yol veya mutlak yol olabilir.
#   Windows'ta ters bölü ÇİFT yazılır (aşağıdaki gibi); tek ters bölü Java .properties
#   kaçış kuralı yüzünden sessizce yutulur ve yol bozulur.
#
# Dosya yoksa ya da işaret ettiği .jks bulunamazsa build başarısız olmaz; release imzalamayı
# atlar ve nedenini söyleyen bir uyarı basar. Ayrıntı: docs/release/anahtar-yonetimi.md

storeFile=D:\\PROJECTS\\keys\\syncron-cap-keystore.jks
storePassword=
keyAlias=syncron
keyPassword=
