/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "syncron-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-04",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"FIREBASE_PROJECT_ID": "syncron-1923",
		// "*.crazygames.com" / "*.gamedistribution.com": portal build'lerini iframe içinde
		// sunan alt domain önceden bilinemediği için suffix eşleşmesiyle karşılanır
		// (bkz. src/index.ts `originMatchesPattern`). localhost:4300/4301:
		// `npm run serve:portal` ile yerel portal testi.
		"ALLOWED_ORIGIN": "http://localhost:3000, http://localhost:4300, http://localhost:4301, http://localhost, capacitor://localhost, https://syncron-1923.web.app, https://syncron-1923.firebaseapp.com, https://know-and-conquer.web.app, https://know-and-conquer.firebaseapp.com, https://syncron.polimelo.com, *.crazygames.com, *.gamedistribution.com"
		// FIREBASE_API_KEY is provisioned as a secret — NOT a plain var (git-leak risk).
		// Set once with: wrangler secret put FIREBASE_API_KEY
	},
	// ─── Cron Triggers ───────────────────────────────────────────────────────
	// "0 3 * * SUN" → runLogRetention()      — every Sunday   03:00 UTC
	// "5 0 * * MON" → runBadgeDistribution() — every Monday   00:05 UTC (weekly badges)
	// "5 0 1 * *"   → runBadgeDistribution() — 1st of month   00:05 UTC (monthly badges)
	// "0 4 * * *"   → runAnonymousCleanup()  — every day      04:00 UTC (D1 anonymous cleanup)
	// "0 2 * * SAT" → runDataExport()        — every Saturday 02:00 UTC (kaynak tablolar → R2 NDJSON)
	//                 Kopyalama; D1'den hiçbir şey silinmez. bkz. docs/release/veri-kurtarma.md
	// "45 3 * * *"  → runSecurityEventRetention() — every day 03:45 UTC
	//                 30 günden eski `security_events` satırlarını SİLER. Arşivlenmez,
	//                 R2'ye gitmez (kişisel veri). bkz. .plans/yayin-hazirlik/05-loglama-ve-adli-iz.md
	"triggers": {
		"crons": [
			"0 3 * * SUN",
			"5 0 * * MON",
			"5 0 1 * *",
			"0 4 * * *",
			"0 2 * * SAT",
			"45 3 * * *"
		]
	},
	// ─── D1 Database ─────────────────────────────────────────────────────────
	// Create with: wrangler d1 create syncron-audit-logs
	// Then paste the database_id output below.
	"d1_databases": [
		{
			"binding": "AUDIT_DB",
			"database_name": "syncron-audit-logs",
			"database_id": "81a86126-95ec-4268-8eb9-e90ac71bab94"
		}
	],
	// ─── Rate Limiting Bindings ──────────────────────────────────────────────
	// Paylaşılan (kenar tarafında, isolate'ten bağımsız) hız limiti sayaçları.
	// bkz. src/services/rateLimit/README.md · .plans/yayin-hazirlik/notlar.md §2
	//
	// ADLANDIRMA SÖZLEŞMESİ — DEĞİŞTİRME: `RL_<limit>_PER_<saniye>S`.
	// Kod binding adını kuralın SAYILARINDAN türetir (lib/bindingName.ts), bu
	// yüzden kademe tablosundaki (lib/policy.ts) her dakikalık eşiğin burada
	// aynı adla bir karşılığı olmalıdır. Ad tutmazsa o kural sessizce değil,
	// `console.warn` ile bellek içi katmana düşer.
	//
	// PLATFORM SINIRI: `period` yalnızca 10 veya 60 saniye olabilir. Bu yüzden
	// `strict` kademesinin SAATLİK ikinci tavanı (600/saat) burada ifade
	// EDİLEMEZ; o kural bellek içi katmanda kalır. Dakikalık tavan (30/dk)
	// paylaşılan sayaçla uygulandığı için asıl koruma buradadır.
	//
	// `namespace_id` yalnızca sayaç uzayını ayıran bir kimliktir; aynı id'yi iki
	// farklı limitte KULLANMA, kovalar birbirine karışır.
	"ratelimits": [
		// strict   — /complete-level, /daily/complete
		{ "name": "RL_30_PER_60S", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		// moderate — /rewards/*, /friends/request, /badges/showcase
		{ "name": "RL_60_PER_60S", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
		// relaxed  — /game/telemetry, /game/feedback, /played-levels
		{ "name": "RL_120_PER_60S", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
		// support  — /create-ticket
		{ "name": "RL_2_PER_60S", "namespace_id": "1004", "simple": { "limit": 2, "period": 60 } },
		// internalLog — global kova
		{ "name": "RL_100_PER_60S", "namespace_id": "1005", "simple": { "limit": 100, "period": 60 } },
		// internalLog — uid kovası
		{ "name": "RL_20_PER_60S", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
		// adminSensitive — /admin/recovery/recompute, /admin/levels/*
		{ "name": "RL_10_PER_60S", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } }
	],
	"r2_buckets": [
		{
			"binding": "syncron_audit_archive",
			"bucket_name": "syncron-audit-archive"
		}
	]
	// Secrets (set via CLI, never in this file):
	//   wrangler secret put GOOGLE_SERVICE_ACCOUNT
	//   wrangler secret put LOG_SECRET
	//   wrangler secret put LS_WEBHOOK_SECRET
	//   wrangler secret put LS_API_KEY
	//   wrangler secret put SECURITY_IP_SALT   — security_events.ip karma tuzu (05)
}